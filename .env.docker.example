# Copy this file to .env.docker. That file is ignored by Git and Docker builds.
# Start with: docker compose --env-file .env.docker up -d --pull always --no-build --wait

# REQUIRED: Docker Hub username whose public pogo-meetups repository holds the image.
# Use the same value as the DOCKERHUB_USERNAME GitHub Actions secret.
DOCKERHUB_USERNAME=

# Hostname used in email and sharing links, without http:// or a path.
PHX_HOST=localhost

# HTTP port. Stop the development server if it already uses 5000.
APP_PORT=5000

# Public URL behind an HTTPS reverse proxy. Keep APP_PORT=5000 for Nginx's upstream.
# PHX_HOST=cameetup.curious-code.fyi
# PUBLIC_SCHEME=https
# PUBLIC_PORT=443

# REQUIRED: generate with openssl rand -hex 24. Use hex to keep the DB URL valid.
POSTGRES_PASSWORD=

# REQUIRED: separate database administrator password; generate with openssl rand -hex 24.
# The application continues to use POSTGRES_PASSWORD, never this admin credential.
POSTGRES_ADMIN_PASSWORD=

# REQUIRED: generate with openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=

# REQUIRED: generate with openssl rand -base64 32. Keep this key across restarts.
# When importing existing data, keep its previous key or save Campfire tokens again.
CREDENTIALS_MASTER_KEY_BASE64=

# REQUIRED: SMTP account for confirmation, sign-in and password reset emails.
# Gmail example: enable 2-Step Verification and generate an App Password.
# Use the App Password without spaces, not your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# For Gmail, use the same email address as SMTP_USERNAME.
MAIL_FROM=
# Other providers: use their SMTP host and credentials.
# For implicit TLS use SMTP_SECURITY=ssl and SMTP_PORT=465.

# Compose project name determines the persistent volume names.
# For a deployment created under the previous project name, keep COMPOSE_PROJECT_NAME=campfire-atlas.
COMPOSE_PROJECT_NAME=pogo-meetups

# Optional runtime settings. Defaults are shown here.
POOL_SIZE=10
OBAN_IMPORT_QUEUE_LIMIT=10
OBAN_RETRY_QUEUE_LIMIT=5
OBAN_MAINTENANCE_QUEUE_LIMIT=2
CAMPFIRE_GRAPHQL_ENDPOINT=https://niantic-social-api.nianticlabs.com/graphql
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Compose configures these automatically:
# DATABASE_URL points to the included PostgreSQL service.
# PHX_SERVER=true and PORT=5000 run the release inside the container.
# IMAGE_STORAGE_PATH=/app/storage/meetup_images uses the persistent images volume.
# PUBLIC_PORT defaults to APP_PORT unless overridden for a reverse proxy.
# See docs/deployment.md for existing data and backups.
