<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="atlas-landing-hero grid lg:grid-cols-2 gap-12 items-center py-8 lg:py-12">
    <div class="atlas-landing-copy">
      <h1 class="atlas-display atlas-hero-title">
        Map your<br /><span class="atlas-hero-word">meetups<svg
          class="atlas-hero-underline"
          viewBox="0 0 450 28"
          fill="none"
          aria-hidden="true"
        ><path d="M8 18C110 2 235 3 442 12M70 25C215 13 305 14 386 20" pathLength="1" /></svg></span>
      </h1>
      <p class="mt-7 text-sm sm:text-base opacity-65 leading-relaxed">
        Import Campfire links, share maps, or export KML.
      </p>
      <div class="atlas-landing-actions flex flex-wrap gap-3 mt-8">
        <.link
          href={if @current_scope, do: ~p"/dashboard/maps", else: ~p"/auth/users/register"}
          class="btn btn-primary"
        >Make a new map <.icon name="hero-arrow-up-right" class="size-4" /></.link><a
          href="#how-it-works"
          class="btn atlas-button"
        >How it works</a>
      </div>
    </div>
    <div class="atlas-card atlas-landing-map relative h-[360px] sm:h-[440px]">
      <CAToolsWeb.MapComponents.map_illustration />
      <p class="absolute bottom-5 left-5 atlas-card px-3 py-2 text-xs opacity-75">
        Map illustration
      </p>
      <label class="atlas-motion-toggle" title="Pause animations">
        <input
          id="hero-motion-paused"
          type="checkbox"
          class="sr-only"
          aria-label="Pause animations"
        />
        <span class="atlas-motion-pause"><.icon name="hero-pause" class="size-4" /></span>
        <span class="atlas-motion-play"><.icon name="hero-play" class="size-4" /></span>
      </label>
    </div>
  </section>
  <section
    id="how-it-works"
    class="border-t border-base-300 mt-12 pt-12 grid md:grid-cols-3 gap-8"
  >
    <article>
      <span class="atlas-section-icon mb-5"><.icon name="hero-link" class="size-5" /></span>
      <h2 class="text-xl font-semibold">
        Add links
      </h2><p class="text-sm opacity-65 leading-relaxed mt-3">
        Save your Campfire token and paste one meetup link per line.
      </p>
    </article>
    <article>
      <span class="atlas-section-icon mb-5" data-tone="coral"><.icon
        name="hero-map-pin"
        class="size-5"
      /></span>
      <h2 class="text-xl font-semibold">
        View locations
      </h2><p class="text-sm opacity-65 leading-relaxed mt-3">
        Imported meetups appear with their names, groups, and times.
      </p>
    </article>
    <article>
      <span class="atlas-section-icon mb-5" data-tone="violet"><.icon
        name="hero-arrow-up-on-square"
        class="size-5"
      /></span>
      <h2 class="text-xl font-semibold">
        Share or export
      </h2><p class="text-sm opacity-65 leading-relaxed mt-3">
        Share a public link or export KML for Google My Maps.
      </p>
    </article>
  </section>
</Layouts.app>
