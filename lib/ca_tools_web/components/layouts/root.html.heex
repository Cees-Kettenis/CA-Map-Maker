<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Welcome" suffix=" · Campfire Atlas" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href={~p"/images/atlas-icon.svg"} sizes="any" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link rel="stylesheet" href={~p"/vendor/leaflet/leaflet.css"} />
    <script defer src={~p"/vendor/leaflet/leaflet.js"}>
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
        const applyTheme = () => {
          const preference = localStorage.getItem("phx:theme") || "light";
          const theme = preference === "system" ? (systemTheme.matches ? "dark" : "light") : preference;
          document.documentElement.setAttribute("data-theme", theme);
        };
        applyTheme();
        document.addEventListener("click", (event) => {
          const button = event.target.closest("button[data-phx-theme]");
          if (button) {
            localStorage.setItem("phx:theme", button.dataset.phxTheme);
            applyTheme();
          }
        });
        window.addEventListener("storage", (event) => {
          if (event.key === "phx:theme" || event.key === null) applyTheme();
        });
        window.addEventListener("phx:page-loading-stop", applyTheme);
        systemTheme.addEventListener("change", () => {
          if (localStorage.getItem("phx:theme") === "system") applyTheme();
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
