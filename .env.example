DATABASE_URL=ecto://postgres:postgres@localhost/ca_tools_dev
TEST_DATABASE_URL=ecto://postgres:postgres@localhost/ca_tools_test
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret
PHX_HOST=localhost
PORT=5000
POOL_SIZE=10
CREDENTIALS_MASTER_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
OBAN_IMPORT_QUEUE_LIMIT=10
OBAN_RETRY_QUEUE_LIMIT=5
OBAN_MAINTENANCE_QUEUE_LIMIT=2
DNS_CLUSTER_QUERY=

# Persistent directory for locally downloaded meetup photos and avatars.
IMAGE_STORAGE_PATH=storage/meetup_images

# Production email settings. Development uses the local mailbox at /dev/mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
